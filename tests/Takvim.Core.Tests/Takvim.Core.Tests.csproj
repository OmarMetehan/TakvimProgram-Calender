<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!--
      xUnit v3 test projeleri kendi başına çalışan bir yürütülebilir üretir.
      Bu makinede zorunluluk: Smart App Control açık ve Microsoft imzalı
      "testhost.exe" içine yüklenen imzasız test derlemelerini engelliyor
      (0x800711C7). Kendi süreci olarak çalışınca engel kalkıyor.
    -->
    <OutputType>Exe</OutputType>
    <AssemblyName>TakvimCekirdekTestleri</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="NodaTime" Version="3.3.3" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Takvim.Core\Takvim.Core.csproj" />
  </ItemGroup>

</Project>