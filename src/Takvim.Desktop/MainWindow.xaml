<Window x:Class="Takvim.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Takvim"
        Height="820" Width="1360"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#16181D">

    <Grid>
        <!-- Sunucu ayağa kalkana kadar görünen açılış katmanı. -->
        <StackPanel x:Name="Splash"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Panel.ZIndex="10">
            <TextBlock Text="📅" FontSize="46" HorizontalAlignment="Center" />
            <TextBlock x:Name="SplashText"
                       Text="Takvim başlatılıyor…"
                       Foreground="#A4ABB8" FontSize="14" Margin="0,10,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" DefaultBackgroundColor="#16181D" />
    </Grid>
</Window>
