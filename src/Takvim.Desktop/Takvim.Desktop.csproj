<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Kestrel ve WebApplication bu çerçeve başvurusuyla gelir; proje
         başvurusu tek başına ASP.NET Core derlemelerini akıtmaz. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Takvim.Server\Takvim.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Tepsi simgesi için: WPF'in kendi tepsi desteği yok, NotifyIcon
         Windows Forms'ta. Pencereler yine WPF ile çizilir. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Takvim</AssemblyName>
    <RootNamespace>Takvim.Desktop</RootNamespace>
  </PropertyGroup>

  <!--
    Web SDK'nın statik varlık işleyişi, ona başvuran düz bir masaüstü projesine
    akmıyor: wwwroot çıktıya hiç kopyalanmıyordu ve uygulama biçimsiz açılıyordu.
    Dosyalar burada açıkça taşınır.
  -->
  <ItemGroup>
    <SunucuVarliklari Include="..\Takvim.Server\wwwroot\**\*" />

    <Content Include="@(SunucuVarliklari)"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Kapsamlı (scoped) CSS paketi wwwroot'ta değil, web projesinin ara
    çıktısında üretilir; oradan alınır. Derleme sırasında henüz var olmadığı
    için hedef içinde toplanır, dosya listesi o anda değerlendirilsin diye.
  -->
  <!--
    Blazor'ın kendi betikleri (blazor.web.js ve arkadaşları) wwwroot'ta değil,
    çerçeveyle gelen bir NuGet paketindedir. Web projesi yayımlanırken bunlar
    wwwroot'a taşınır; masaüstü kabuğu yayımlanmadığı için taşınmıyordu ve
    uç nokta bildirimi dosyaları web kökünde arayıp bulamıyordu — istekler
    500 dönüyor, arayüz tıklamalara yanıt vermiyordu.

    Paket sürümü çerçeve sürümünü izler; ikisi ayrı ayrı yazılmasın diye
    BundledNETCoreAppPackageVersion kullanılır.
  -->
  <PropertyGroup>
    <CercevveVarlikYolu>$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets\$(BundledNETCoreAppPackageVersion)\_framework\</CercevveVarlikYolu>
  </PropertyGroup>

  <Target Name="CerceveVarliklariKopyala" AfterTargets="Build">
    <ItemGroup>
      <CerceveVarligi Include="$(CercevveVarlikYolu)**\*" />
    </ItemGroup>

    <Error Condition="'@(CerceveVarligi)' == ''"
           Text="Blazor çerçeve varlıkları bulunamadı: $(CercevveVarlikYolu). Bunlar olmadan arayüz etkileşimsiz açılır." />

    <Copy SourceFiles="@(CerceveVarligi)"
          DestinationFolder="$(OutDir)wwwroot\_framework\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Bileşenin yanında duran betikler (ReconnectModal.razor.js) da statik
    varlıktır ve bileşenin klasör yoluyla sunulur; wwwroot'ta değil, kaynak
    ağacındadırlar.
  -->
  <ItemGroup>
    <BilesenBetigi Include="..\Takvim.Server\Components\**\*.razor.js" />

    <Content Include="@(BilesenBetigi)"
             Link="wwwroot\Components\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="KapsamliCssKopyala" AfterTargets="Build">
    <ItemGroup>
      <KapsamliCss Include="..\Takvim.Server\obj\$(Configuration)\net10.0\scopedcss\bundle\Takvim.Server.styles.css" />
    </ItemGroup>

    <Copy SourceFiles="@(KapsamliCss)"
          DestinationFolder="$(OutDir)wwwroot"
          SkipUnchangedFiles="true"
          Condition="Exists('%(KapsamliCss.FullPath)')" />
  </Target>

</Project>
