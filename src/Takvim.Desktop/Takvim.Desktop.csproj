<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Kestrel ve WebApplication bu çerçeve başvurusuyla gelir; proje
         başvurusu tek başına ASP.NET Core derlemelerini akıtmaz. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Takvim.Server\Takvim.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Takvim</AssemblyName>
    <RootNamespace>Takvim.Desktop</RootNamespace>
  </PropertyGroup>

</Project>
