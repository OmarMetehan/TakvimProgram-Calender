@* Yedekleme ve geri yükleme. *@

<div class="perde" @onclick="() => OnClose.InvokeAsync()"></div>

<div class="panel" role="dialog" aria-modal="true" aria-label="Yedekleme">

    <div class="panel__ust">
        <h2 class="panel__baslik">Yedekleme</h2>
        <button class="dugme dugme--simge" aria-label="Kapat" title="Kapat (Esc)"
                @onclick="() => OnClose.InvokeAsync()">✕</button>
    </div>

    <div class="panel__govde">

        <p style="color:var(--metin-2);margin:0">
            Yedek tek bir dosyadır: veritabanı ve dosya ekleri birlikte.
            Günde bir kez kendiliğinden alınır, son @BackupService.DefaultKeepCount tanesi saklanır.
        </p>

        @if (_pending)
        {
            <div class="kaynak-arama" style="border-color:var(--uyari)">
                <div style="font-weight:500;margin-bottom:4px">Geri yükleme bekliyor</div>

                <div style="color:var(--metin-2);font-size:13px;margin-bottom:8px">
                    Seçtiğiniz yedek hazır. <b>Uygulamayı kapatıp yeniden açtığınızda</b>
                    uygulanacak — çalışan bir uygulamanın altından veritabanını
                    değiştirmek açık işlemleri bozardı.
                </div>

                <div style="display:flex;gap:6px">
                    <span class="panel__bosluk"></span>
                    <button class="dugme dugme--tehlike" @onclick="CancelRestore">
                        Geri yüklemeyi iptal et
                    </button>
                </div>
            </div>
        }

        @if (_message is { } message)
        {
            <div role="alert" style="font-size:12px;color:@(_failed ? "var(--tehlike)" : "var(--basari)")">
                @message
            </div>
        }

        <div style="display:flex;gap:6px;align-items:center">
            <button class="dugme dugme--birincil" disabled="@_working" @onclick="CreateBackup">
                @(_working ? "Alınıyor…" : "Şimdi yedek al")
            </button>

            <span class="panel__bosluk"></span>

            <span style="font-size:11px;color:var(--metin-3)">
                Klasör: <code style="user-select:all">@Root</code>
            </span>
        </div>

        @if (_backups.Count == 0)
        {
            <div class="bos-durum">
                <div class="bos-durum__baslik">Henüz yedek yok</div>
                <div>İlk yedek uygulama birkaç dakika açık kaldıktan sonra kendiliğinden alınır.</div>
            </div>
        }
        else
        {
            @foreach (var backup in _backups)
            {
                <div class="kaynak-satiri">
                    <span aria-hidden="true">🗄</span>

                    <span style="flex:1;min-width:0">
                        <span style="display:block;font-weight:500">
                            @TurkishFormat.DateTime(LocalOf(backup.CreatedAt))
                        </span>
                        <span style="display:block;font-size:11px;color:var(--metin-3)">
                            @backup.SizeText@ContentsLabel(backup)
                        </span>
                    </span>

                    <button class="dugme" @onclick="() => AskRestore(backup)">Geri yükle</button>

                    <button class="dugme dugme--simge dugme--tehlike" title="Sil"
                            aria-label="@($"{backup.Name} yedeğini sil")"
                            @onclick="() => Delete(backup)">✕</button>
                </div>
            }
        }

        @* ---------- Geri yükleme onayı ---------- *@

        @if (_restoring is { } target)
        {
            <div class="kaynak-arama" style="border-color:var(--tehlike)">
                <div style="font-weight:500;margin-bottom:6px">
                    @TurkishFormat.DateTime(LocalOf(target.CreatedAt)) yedeği geri yüklensin mi?
                </div>

                <div style="color:var(--metin-2);font-size:13px;margin-bottom:8px">
                    <div>
                        Şu anki veriler bu yedektekilerle <b>değiştirilecek</b>.
                        Yedekten sonra eklediğiniz her şey kaybolur.
                    </div>

                    <div style="margin-top:4px">
                        Şimdiki veritabanınız silinmez, yanına <code>takvim.onceki-…</code>
                        adıyla saklanır.
                    </div>

                    <div style="margin-top:4px">
                        Uygulamayı kapatıp yeniden açmanız gerekecek.
                    </div>
                </div>

                <div style="display:flex;gap:6px">
                    <span class="panel__bosluk"></span>
                    <button class="dugme" @onclick="() => _restoring = null">Vazgeç</button>
                    <button class="dugme dugme--tehlike" @onclick="ConfirmRestore">Geri yükle</button>
                </div>
            </div>
        }
    </div>

    <div class="panel__alt">
        <span class="panel__bosluk"></span>
        <button class="dugme" @onclick="() => OnClose.InvokeAsync()">Kapat</button>
    </div>
</div>

@code {
    [CascadingParameter] public required CalendarUiState State { get; set; }

    [Inject] public required IServiceScopeFactory Scopes { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private List<BackupFile> _backups = [];
    private BackupFile? _restoring;

    private bool _pending;
    private bool _working;
    private string? _message;
    private bool _failed;

    private static string Root => Takvim.Data.TakvimPaths.BackupsRoot;

    protected override void OnInitialized() => Load();

    private void Load()
    {
        using var scope = Scopes.CreateScope();

        _backups = scope.ServiceProvider.GetRequiredService<BackupService>().List();
        _pending = BackupService.HasPendingRestore();
    }

    private LocalDateTime LocalOf(DateTimeOffset moment)
        => LocalDateTime.FromDateTime(moment.LocalDateTime);

    /// <summary>Künyedeki sayılar okunabiliyorsa gösterilir.</summary>
    private static string ContentsLabel(BackupFile backup)
    {
        if (BackupService.ReadManifest(backup.Path) is not { } manifest) return " · okunamadı";

        var parts = new List<string> { $"{manifest.EventCount} etkinlik" };

        if (manifest.AttachmentCount > 0) parts.Add($"{manifest.AttachmentCount} ek");

        return " · " + string.Join(", ", parts);
    }

    // ------------------------------------------------------------------

    private async Task CreateBackup()
    {
        _working = true;
        _message = null;

        try
        {
            await using var scope = Scopes.CreateAsyncScope();

            var result = await scope.ServiceProvider.GetRequiredService<BackupService>().CreateAsync();

            Report(result.Success ? $"Yedek alındı: {result.Backup!.SizeText}" : result.Error!,
                   failed: !result.Success);
        }
        finally
        {
            _working = false;
        }

        Load();
    }

    private void Delete(BackupFile backup)
    {
        using (var scope = Scopes.CreateScope())
        {
            scope.ServiceProvider.GetRequiredService<BackupService>().Delete(backup.Path);
        }

        Report("Yedek silindi.", failed: false);
        Load();
    }

    private void AskRestore(BackupFile backup)
    {
        _restoring = backup;
        _message = null;
    }

    private void ConfirmRestore()
    {
        if (_restoring is not { } target) return;

        var problem = BackupService.StageRestore(target.Path);

        _restoring = null;

        Report(problem ?? "Geri yükleme hazır. Uygulamayı kapatıp yeniden açın.",
               failed: problem is not null);

        Load();
    }

    private void CancelRestore()
    {
        BackupService.CancelPendingRestore();

        Report("Geri yükleme iptal edildi.", failed: false);
        Load();
    }

    private void Report(string message, bool failed)
    {
        _message = message;
        _failed = failed;
    }
}
