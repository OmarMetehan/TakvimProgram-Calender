@* Bildirim tercihleri: hatırlatıcı anahtarı ve sessiz saatler. *@

<div class="perde" @onclick="() => OnClose.InvokeAsync()"></div>

<div class="panel" role="dialog" aria-modal="true" aria-label="Bildirim ayarları">

    <div class="panel__ust">
        <h2 class="panel__baslik">Bildirim ayarları</h2>
        <button class="dugme dugme--simge" aria-label="Kapat" title="Kapat (Esc)"
                @onclick="() => OnClose.InvokeAsync()">✕</button>
    </div>

    <div class="panel__govde">

        <p style="color:var(--metin-2);margin:0">
            Bu ayarlar <b>@(State.ActiveUser?.DisplayName ?? "bu hesap")</b> hesabına aittir ve
            hatırlatıcıların ne zaman görüneceğini belirler. Hatırlatıcıların kendisi
            etkinliklerde durur; buradan kapatmak hiçbirini silmez.
        </p>

        @* ---------------- Şu anki durum ---------------- *@

        <div class="kaynak-arama" style="@(_silence.IsSilenced ? "border-color:var(--uyari)" : "")">
            <div style="display:flex;align-items:center;gap:8px">
                <span aria-hidden="true" style="font-size:17px">@(_silence.IsSilenced ? "🔕" : "🔔")</span>

                <span style="flex:1;min-width:0">
                    <span style="display:block;font-weight:500">
                        @(_silence.IsSilenced ? "Bildirimler şu an susturulmuş" : "Bildirimler açık")
                    </span>
                    <span style="display:block;font-size:12px;color:var(--metin-3)">
                        @StatusDetail()
                    </span>
                </span>
            </div>
        </div>

        @* ---------------- Ana anahtar ---------------- *@

        <section>
            <label class="liste-ogesi" style="padding-left:0">
                <input type="checkbox" class="onay-kutusu" style="--olay-renk:var(--birincil)"
                       checked="@_remindersEnabled"
                       @onchange="e => _remindersEnabled = (bool)(e.Value ?? false)" />
                <span class="liste-ogesi__ad">
                    <strong>Hatırlatıcı bildirimleri</strong>
                    <span style="display:block;font-size:12px;color:var(--metin-3)">
                        Kapalıyken hiçbir hatırlatıcı çalmaz; etkinliklerdeki uyarılar korunur.
                    </span>
                </span>
            </label>
        </section>

        <hr style="border:none;border-top:1px solid var(--cizgi)" />

        @* ---------------- Sessiz saatler ---------------- *@

        <section>
            <label class="liste-ogesi" style="padding-left:0">
                <input type="checkbox" class="onay-kutusu" style="--olay-renk:var(--birincil)"
                       disabled="@(!_remindersEnabled)"
                       checked="@_quietEnabled"
                       @onchange="e => _quietEnabled = (bool)(e.Value ?? false)" />
                <span class="liste-ogesi__ad">
                    <strong>Sessiz saatler</strong>
                    <span style="display:block;font-size:12px;color:var(--metin-3)">
                        Bu aralıkta bildirim çıkmaz.
                    </span>
                </span>
            </label>

            @if (_quietEnabled && _remindersEnabled)
            {
                <div style="display:flex;align-items:center;gap:8px;margin:8px 0 0 4px">
                    <label style="font-size:13px;color:var(--metin-2)" for="sessiz-baslangic">Başlangıç</label>
                    <input id="sessiz-baslangic" class="alan" type="time" style="width:104px"
                           value="@Format(_quietStart)"
                           @onchange="e => _quietStart = ParseTime(e.Value, _quietStart)" />

                    <label style="font-size:13px;color:var(--metin-2)" for="sessiz-bitis">Bitiş</label>
                    <input id="sessiz-bitis" class="alan" type="time" style="width:104px"
                           value="@Format(_quietEnd)"
                           @onchange="e => _quietEnd = ParseTime(e.Value, _quietEnd)" />
                </div>

                <p style="font-size:12px;color:var(--metin-3);margin:8px 0 0 4px">
                    @WindowLabel()
                </p>

                <label class="liste-ogesi" style="padding-left:0;margin-top:6px">
                    <input type="checkbox" class="onay-kutusu" style="--olay-renk:var(--birincil)"
                           checked="@_quietOnDaysOff"
                           @onchange="e => _quietOnDaysOff = (bool)(e.Value ?? false)" />
                    <span class="liste-ogesi__ad">
                        Çalışılmayan günlerde bütün gün sessiz
                        <span style="display:block;font-size:12px;color:var(--metin-3)">
                            Hafta sonu, resmi tatil ve izin günleri — çalışma düzenine göre.
                        </span>
                    </span>
                </label>
            }
        </section>

        <div class="kaynak-arama">
            <div style="font-size:12px;color:var(--metin-2)">
                <div><b>Sessizlik hatırlatıcıyı silmez, ertelemez.</b></div>
                <div style="margin-top:4px">
                    Sessiz saatlerde tetiklenen bir hatırlatıcı gösterilmez ama kapatılmış da
                    sayılmaz: pencere kapandığında etkinlik hâlâ yaklaşıyorsa uyarı o an çıkar.
                    Gece boyunca geçenler sabah topluca dökülmez — hatırlatıcı motoru,
                    başlangıcının üzerinden @MissedGraceMinutes dakikadan fazla geçen uyarıları
                    zaten eler.
                </div>
            </div>
        </div>

        @if (_message is { } message)
        {
            <div role="alert" style="font-size:12px;color:@(_failed ? "var(--tehlike)" : "var(--basari)")">
                @message
            </div>
        }
    </div>

    <div class="panel__alt">
        <span class="panel__bosluk"></span>
        <button class="dugme" @onclick="() => OnClose.InvokeAsync()">Kapat</button>
        <button class="dugme dugme--birincil" disabled="@_saving" @onclick="Save">Kaydet</button>
    </div>
</div>

@code {
    [CascadingParameter] public required CalendarUiState State { get; set; }

    [Inject] public required IServiceScopeFactory Scopes { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private bool _remindersEnabled = true;
    private bool _quietEnabled;
    private LocalTime _quietStart = new(22, 0);
    private LocalTime _quietEnd = new(8, 0);
    private bool _quietOnDaysOff;

    private SilenceState _silence = SilenceState.Audible;

    private bool _saving;
    private string? _message;
    private bool _failed;

    private static int MissedGraceMinutes => (int)ReminderService.MissedGrace.TotalMinutes;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var scope = Scopes.CreateAsyncScope();
        var service = scope.ServiceProvider.GetRequiredService<NotificationSettingsService>();

        var settings = await service.GetAsync(State.ActiveUserId);

        _remindersEnabled = settings.RemindersEnabled;
        _quietEnabled = settings.Quiet.Enabled;
        _quietStart = settings.Quiet.Start;
        _quietEnd = settings.Quiet.End;
        _quietOnDaysOff = settings.Quiet.AllDayOnDaysOff;

        _silence = await service.EvaluateAsync(State.ActiveUserId);
    }

    private async Task Save()
    {
        _saving = true;
        _message = null;

        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            var service = scope.ServiceProvider.GetRequiredService<NotificationSettingsService>();

            var settings = new NotificationSettings(
                _remindersEnabled,
                new QuietHours(_quietEnabled, _quietStart, _quietEnd, _quietOnDaysOff));

            await service.SaveAsync(State.ActiveUserId, settings);

            _silence = await service.EvaluateAsync(State.ActiveUserId);
            Report("Bildirim ayarları kaydedildi.", failed: false);
        }
        catch (InvalidOperationException ex)
        {
            Report(ex.Message, failed: true);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Report(string message, bool failed)
    {
        _message = message;
        _failed = failed;
    }

    // ------------------------------------------------------------------

    /// <summary>Durum kutusunun ikinci satırı: neden sessiz, ne zamana kadar.</summary>
    private string StatusDetail()
    {
        if (!_silence.IsSilenced)
        {
            return "Zamanı gelen hatırlatıcılar sağ altta görünür, pencere kapalıysa tepside.";
        }

        var reason = _silence.Reason ?? "Sessiz saatler.";

        return _silence.EndsAt is { } endsAt
            ? $"{reason} {Format(endsAt.TimeOfDay)} sonrasında yeniden çalar."
            : reason;
    }

    /// <summary>Pencerenin gece yarısını aşıp aşmadığını okunur biçimde söyler.</summary>
    private string WindowLabel()
    {
        if (_quietStart == _quietEnd) return "Başlangıç ve bitiş aynı olamaz.";

        return _quietStart < _quietEnd
            ? $"Her gün {Format(_quietStart)} – {Format(_quietEnd)} arası sessiz."
            : $"Her gece {Format(_quietStart)} – ertesi gün {Format(_quietEnd)} arası sessiz.";
    }

    private static string Format(LocalTime time) => $"{time.Hour:00}:{time.Minute:00}";

    private static LocalTime ParseTime(object? value, LocalTime fallback)
        => TurkishFormat.TryParseTime(value?.ToString(), out var parsed) ? parsed : fallback;
}
