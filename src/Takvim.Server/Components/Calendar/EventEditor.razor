@* Etkinlik düzenleme paneli. Yeni ve var olan etkinlikler için aynı form. *@

<div class="perde" @onclick="() => OnCancel.InvokeAsync()"></div>

<div class="panel" role="dialog" aria-modal="true" aria-label="@(Draft.IsNew ? "Yeni etkinlik" : "Etkinliği düzenle")">

    <div class="panel__ust">
        <h2 class="panel__baslik">@(Draft.IsNew ? "Yeni etkinlik" : "Etkinliği düzenle")</h2>
        <button class="dugme dugme--simge" aria-label="Kapat" title="Kapat (Esc)"
                @onclick="() => OnCancel.InvokeAsync()">✕</button>
    </div>

    <div class="panel__govde">

        @if (_problems.Count > 0)
        {
            <div role="alert" style="border:1px solid var(--tehlike);border-radius:var(--yuvarlak);padding:9px 11px;color:var(--tehlike)">
                @foreach (var problem in _problems)
                {
                    <div>@problem</div>
                }
            </div>
        }

        @if (Draft.IsNew && _templates.Count > 0)
        {
            <div>
                <span class="etiket">Şablondan doldur</span>
                <div style="display:flex;gap:5px;flex-wrap:wrap">
                    @foreach (var template in _templates)
                    {
                        <span class="sablon-rozeti">
                            <button type="button" class="sablon-rozeti__ad"
                                    title="@($"{template.Name} şablonunu uygula")"
                                    @onclick="() => ApplyTemplate(template.Id)">@template.Name</button>

                            <button type="button" class="sablon-rozeti__sil"
                                    title="Şablonu sil" aria-label="@($"{template.Name} şablonunu sil")"
                                    @onclick="() => DeleteTemplate(template.Id)">✕</button>
                        </span>
                    }
                </div>
            </div>
        }

        <div>
            <label class="etiket" for="olay-baslik">Başlık</label>
            <input id="olay-baslik" class="alan" placeholder="Etkinlik başlığı"
                   @bind="Draft.Title" @bind:event="oninput" />
        </div>

        <div>
            <label class="etiket" for="olay-takvim">Takvim</label>
            <select id="olay-takvim" class="alan" @bind="Draft.CalendarId">
                @foreach (var calendar in State.WritableCalendars)
                {
                    <option value="@calendar.Id">@calendar.Name</option>
                }
            </select>
        </div>

        @* ---------- Zaman ---------- *@

        <div style="display:flex;flex-direction:column;gap:8px">
            <label class="liste-ogesi" style="padding-left:0">
                <input type="checkbox" class="onay-kutusu" style="--olay-renk:var(--birincil)"
                       checked="@Draft.IsAllDay" @onchange="ToggleAllDay" />
                <span class="liste-ogesi__ad">Tüm gün</span>
            </label>

            <div style="display:grid;grid-template-columns:1fr auto;gap:8px;align-items:end">
                <div>
                    <label class="etiket" for="olay-bas-tarih">Başlangıç</label>
                    <input id="olay-bas-tarih" class="alan" type="date"
                           value="@Draft.StartDate" @onchange="OnStartDateChanged" />
                </div>
                @if (!Draft.IsAllDay)
                {
                    <div>
                        <label class="etiket" for="olay-bas-saat">Saat</label>
                        <input id="olay-bas-saat" class="alan" type="time" style="width:118px"
                               value="@Draft.StartTime" @onchange="OnStartTimeChanged" />
                    </div>
                }
            </div>

            <div style="display:grid;grid-template-columns:1fr auto;gap:8px;align-items:end">
                <div>
                    <label class="etiket" for="olay-bit-tarih">@(Draft.IsAllDay ? "Son gün" : "Bitiş")</label>
                    <input id="olay-bit-tarih" class="alan" type="date"
                           value="@Draft.EndDate"
                           @onchange="e => Draft.EndDate = e.Value?.ToString() ?? Draft.EndDate" />
                </div>
                @if (!Draft.IsAllDay)
                {
                    <div>
                        <label class="etiket" for="olay-bit-saat">Saat</label>
                        <input id="olay-bit-saat" class="alan" type="time" style="width:118px"
                               value="@Draft.EndTime"
                               @onchange="e => Draft.EndTime = e.Value?.ToString() ?? Draft.EndTime" />
                    </div>
                }
            </div>

            @if (!Draft.IsAllDay)
            {
                <button class="dugme dugme--sade" style="align-self:flex-start"
                        @onclick="() => OnFindTime.InvokeAsync(Draft)">
                    🔍 Uygun zaman bul
                </button>

                <details>
                    <summary style="cursor:pointer;font-size:13px;color:var(--metin-2)">Zaman dilimi</summary>
                    <div style="display:flex;flex-direction:column;gap:8px;padding-top:8px">
                        <select class="alan" @bind="Draft.StartTimeZoneId" aria-label="Başlangıç zaman dilimi">
                            @foreach (var zone in CommonZones)
                            {
                                <option value="@zone">@zone</option>
                            }
                        </select>

                        <label class="liste-ogesi" style="padding-left:0">
                            <input type="checkbox" class="onay-kutusu" style="--olay-renk:var(--birincil)"
                                   checked="@Draft.SplitTimeZones"
                                   @onchange="e => Draft.SplitTimeZones = (bool)(e.Value ?? false)" />
                            <span class="liste-ogesi__ad">Bitiş farklı bir dilimde</span>
                        </label>

                        @if (Draft.SplitTimeZones)
                        {
                            <select class="alan" @bind="Draft.EndTimeZoneId" aria-label="Bitiş zaman dilimi">
                                @foreach (var zone in CommonZones)
                                {
                                    <option value="@zone">@zone</option>
                                }
                            </select>
                        }
                    </div>
                </details>
            }
        </div>

        @* ---------- Tekrar ---------- *@

        <div>
            <label class="etiket" for="olay-tekrar">Tekrar</label>
            <select id="olay-tekrar" class="alan" @bind="Draft.RecurrencePreset">
                <option value="@RecurrencePreset.None">Tekrarlamaz</option>
                <option value="@RecurrencePreset.Daily">Her gün</option>
                <option value="@RecurrencePreset.WeeklyOnStartDay">Her hafta @TurkishFormat.DayName(Draft.Start.Date).ToLower(TurkishFormat.Culture)</option>
                <option value="@RecurrencePreset.EveryWeekday">Hafta içi her gün</option>
                <option value="@RecurrencePreset.MonthlyOnDayOfMonth">Her ay ayın @Draft.Start.Day'inde</option>
                <option value="@RecurrencePreset.MonthlyOnNthWeekday">Her ay aynı sıradaki gün</option>
                <option value="@RecurrencePreset.Yearly">Her yıl</option>
                <option value="@RecurrencePreset.Custom">Özel kural…</option>
            </select>

            @if (Draft.RecurrencePreset == RecurrencePreset.Custom)
            {
                <input class="alan" style="margin-top:6px;font-family:ui-monospace,monospace;font-size:12px"
                       placeholder="FREQ=WEEKLY;INTERVAL=2;BYDAY=MO,WE"
                       @bind="Draft.CustomRecurrenceRule" @bind:event="oninput" />
            }

            @if (Draft.RecurrencePreset != RecurrencePreset.None)
            {
                <div style="font-size:12px;color:var(--metin-2);margin-top:5px">@Draft.RecurrenceDescription</div>

                <label class="etiket" for="olay-tatil" style="margin-top:8px">Resmi tatile denk gelirse</label>
                <select id="olay-tatil" class="alan" @bind="Draft.HolidayBehavior">
                    <option value="@HolidayBehavior.Include">Yine de göster</option>
                    <option value="@HolidayBehavior.Skip">O örneği atla</option>
                    <option value="@HolidayBehavior.MoveToNextWorkingDay">Sonraki iş gününe ertele</option>
                </select>
            }
        </div>

        @* ---------- Katılımcılar ---------- *@

        <AttendeeSection Draft="Draft"
                         OnAcceptProposal="OnAcceptProposal"
                         OnResetResponses="OnResetResponses" />

        @* ---------- Konum ---------- *@

        <div>
            <label class="etiket" for="olay-konum">Konum</label>

            <div style="display:flex;gap:6px">
                <input id="olay-konum" class="alan" placeholder="Oda, adres veya serbest metin"
                       list="kayitli-konumlar" autocomplete="off"
                       @bind="Draft.LocationText" @bind:event="oninput" />

                @if (MeetingLinks.MapSearchUrl(Draft.LocationText) is { } mapUrl)
                {
                    <a class="dugme dugme--simge" href="@mapUrl" target="_blank" rel="noopener noreferrer"
                       title="Haritada aç" aria-label="Konumu haritada aç">🗺</a>
                }
            </div>

            @* Yazarken çıkan öneriler: daha önce kullanılan konumlar. *@
            <datalist id="kayitli-konumlar">
                @foreach (var location in _savedLocations)
                {
                    <option value="@location.Text"></option>
                }
            </datalist>

            @if (_savedLocations.Count > 0 && string.IsNullOrWhiteSpace(Draft.LocationText))
            {
                <div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:5px">
                    @foreach (var location in _savedLocations.Take(4))
                    {
                        <button type="button" class="rozet" style="border:1px solid var(--cizgi)"
                                title="@(location.IsPinned ? "Sabitlenmiş konum" : $"{location.UseCount} kez kullanıldı")"
                                @onclick="() => Draft.LocationText = location.Text">
                            @(location.IsPinned ? "📌 " : "")@location.Text
                        </button>
                    }
                </div>
            }
        </div>

        <div>
            <label class="etiket" for="olay-baglanti">Çevrimiçi toplantı</label>
            <div style="display:flex;gap:6px">
                <input id="olay-baglanti" class="alan" placeholder="https://…"
                       value="@Draft.OnlineMeetingUrl" @onchange="OnMeetingUrlChanged" @oninput="OnMeetingUrlChanged" />
                <select class="alan" style="width:112px" @bind="Draft.OnlineMeetingProvider"
                        aria-label="Toplantı sağlayıcısı">
                    <option value="">Sağlayıcı</option>
                    <option value="teams">Teams</option>
                    <option value="meet">Meet</option>
                    <option value="zoom">Zoom</option>
                    <option value="webex">Webex</option>
                    <option value="jitsi">Jitsi</option>
                    <option value="whereby">Whereby</option>
                    <option value="diger">Diğer</option>
                </select>
            </div>

            @if (string.IsNullOrWhiteSpace(Draft.OnlineMeetingUrl))
            {
                <button type="button" class="dugme dugme--sade" style="margin-top:5px"
                        @onclick="CreateMeetingLink">
                    ✨ Toplantı bağlantısı oluştur
                </button>

                <div style="font-size:11px;color:var(--metin-3);margin-top:4px">
                    Hesap gerektirmeyen bir Jitsi Meet odası açar. Teams, Zoom ve Meet
                    bağlantıları o uygulamalardan alınıp buraya yapıştırılır;
                    sağlayıcıları kendiliğinden tanınır.
                </div>
            }
            else
            {
                <div style="display:flex;gap:6px;align-items:center;margin-top:5px">
                    <a class="dugme dugme--sade" href="@Draft.OnlineMeetingUrl"
                       target="_blank" rel="noopener noreferrer">Bağlantıyı aç</a>

                    <button type="button" class="dugme dugme--sade"
                            @onclick="() => { Draft.OnlineMeetingUrl = null; Draft.OnlineMeetingProvider = null; }">
                        Kaldır
                    </button>

                    <span style="font-size:11px;color:var(--metin-3)">
                        @MeetingLinks.ProviderName(Draft.OnlineMeetingProvider)
                    </span>
                </div>
            }
        </div>

        @* ---------- Odalar ve ekipman ---------- *@

        <ResourceSection Draft="Draft" />

        @* ---------- Renk ve kategoriler ---------- *@

        <div>
            <span class="etiket">Renk</span>
            <div style="display:flex;gap:6px;flex-wrap:wrap">
                <button type="button" class="renk-noktasi"
                        style="width:24px;height:24px;border-radius:50%;border:2px solid @(Draft.Color is null ? "var(--birincil)" : "transparent");--olay-renk:var(--metin-3)"
                        title="Takvimin rengi" aria-label="Takvimin rengini kullan"
                        @onclick="() => Draft.Color = null"></button>

                @foreach (var color in Palette)
                {
                    <button type="button" class="renk-noktasi renk-@color"
                            style="width:24px;height:24px;border-radius:50%;border:2px solid @(Draft.Color == color ? "var(--metin)" : "transparent")"
                            title="@color" aria-label="@color rengi"
                            @onclick="() => Draft.Color = color"></button>
                }
            </div>
        </div>

        <div>
            <span class="etiket">Kategoriler</span>
            <div style="display:flex;gap:6px;flex-wrap:wrap">
                @foreach (var category in State.Categories)
                {
                    var selected = Draft.CategoryIds.Contains(category.Id);

                    <button type="button" class="rozet renk-@category.Color"
                            style="border:1px solid @(selected ? "var(--olay-renk)" : "var(--cizgi)");@(selected ? "background:color-mix(in srgb, var(--olay-renk) 16%, transparent)" : "")"
                            aria-pressed="@(selected ? "true" : "false")"
                            @onclick="() => ToggleCategory(category.Id)">
                        <span class="renk-noktasi" style="width:8px;height:8px;border-radius:50%"></span>
                        @category.Name
                    </button>
                }
            </div>
        </div>

        @* ---------- Durum ---------- *@

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <div>
                <label class="etiket" for="olay-durum">Meşguliyet</label>
                <select id="olay-durum" class="alan" @bind="Draft.Availability">
                    <option value="@Availability.Busy">Meşgul</option>
                    <option value="@Availability.Free">Müsait</option>
                    <option value="@Availability.Tentative">Belirsiz</option>
                    <option value="@Availability.OutOfOffice">Ofis dışı</option>
                    <option value="@Availability.WorkingElsewhere">Başka yerde çalışıyor</option>
                    <option value="@Availability.FocusTime">Odaklanma zamanı</option>
                </select>
            </div>

            <div>
                <label class="etiket" for="olay-gorunurluk">Görünürlük</label>
                <select id="olay-gorunurluk" class="alan" @bind="Draft.Visibility">
                    <option value="@EventVisibility.Default">Varsayılan</option>
                    <option value="@EventVisibility.Public">Herkese açık</option>
                    <option value="@EventVisibility.Private">Özel</option>
                </select>
            </div>
        </div>

        <label class="liste-ogesi" style="padding-left:0">
            <input type="checkbox" class="onay-kutusu" style="--olay-renk:var(--birincil)"
                   checked="@(!Draft.IsForwardable)"
                   @onchange="e => Draft.IsForwardable = !(bool)(e.Value ?? false)" />
            <span class="liste-ogesi__ad">
                İletilemez
                <span style="display:block;font-size:11px;color:var(--metin-3)">
                    Davetliler bu toplantıyı başkasına iletemez. Bir politika işaretidir:
                    detayı görebilen biri içeriği yine de elle aktarabilir.
                </span>
            </span>
        </label>

        @if (HasPrivateCategory && Draft.Visibility == EventVisibility.Public)
        {
            <div role="status" style="font-size:12px;color:var(--uyari)">
                Bu etkinlik gizli bir kategoride. Gizlilik, "herkese açık" seçimini geçersiz kılar
                ve paylaşımlarda yalnızca "meşgul" görünür.
            </div>
        }

        @* ---------- Hatırlatıcılar ---------- *@

        <div>
            <span class="etiket">Hatırlatıcılar</span>

            @foreach (var (reminder, index) in Draft.Reminders.Select((r, i) => (r, i)))
            {
                <div style="display:flex;gap:6px;margin-bottom:5px;align-items:center">
                    <select class="alan" style="flex:1" aria-label="Hatırlatma zamanı"
                            value="@reminder.MinutesBefore"
                            @onchange="e => SetReminderMinutes(index, e)">
                        @foreach (var minutes in ReminderChoices)
                        {
                            <option value="@minutes">@TurkishFormat.ReminderOffset(minutes)</option>
                        }
                    </select>
                    <button class="dugme dugme--simge" aria-label="Hatırlatıcıyı kaldır" title="Kaldır"
                            @onclick="() => Draft.Reminders.RemoveAt(index)">✕</button>
                </div>
            }

            <button class="dugme dugme--sade" @onclick="AddReminder">+ Hatırlatıcı ekle</button>
        </div>

        @* ---------- Ekler ---------- *@

        <AttachmentSection EventId="Draft.EventId" />

        @* ---------- Açıklama ---------- *@

        <div>
            <label class="etiket" for="olay-aciklama">Açıklama</label>

            <div class="bicim-cubugu" role="toolbar" aria-label="Metin biçimlendirme">
                @foreach (var tool in Tools)
                {
                    <button type="button" class="dugme dugme--sade bicim-dugmesi"
                            title="@tool.Title" aria-label="@tool.Title"
                            @onclick="() => ApplyFormat(tool)">@((MarkupString)tool.Label)</button>
                }

                <span class="panel__bosluk"></span>

                <button type="button" class="dugme dugme--sade bicim-dugmesi"
                        aria-pressed="@(_previewDescription ? "true" : "false")"
                        @onclick="() => _previewDescription = !_previewDescription">
                    @(_previewDescription ? "Düzenle" : "Önizle")
                </button>
            </div>

            @if (_previewDescription)
            {
                <div class="zengin-metin" aria-live="polite">
                    @((MarkupString)RichText.ToHtml(Draft.DescriptionHtml))
                </div>
            }
            else
            {
                <textarea id="olay-aciklama" class="alan" rows="4"
                          placeholder="Notlar, bağlantılar. **kalın**, *eğik*, - madde"
                          @bind="Draft.DescriptionHtml" @bind:event="oninput"></textarea>
            }
        </div>

        @* ---------- Gündem ve özel notlar ---------- *@

        <details open="@(HasAgendaOrNotes)">
            <summary style="cursor:pointer;font-size:13px;color:var(--metin-2)">
                Gündem ve notlar
            </summary>

            <div style="display:flex;flex-direction:column;gap:10px;padding-top:8px">
                <div>
                    <label class="etiket" for="olay-gundem">Gündem</label>
                    <textarea id="olay-gundem" class="alan" rows="3"
                              placeholder="1. Açılış&#10;2. Geçen haftanın özeti&#10;3. Karar maddeleri"
                              @bind="Draft.AgendaText" @bind:event="oninput"></textarea>
                    <div style="font-size:11px;color:var(--metin-3);margin-top:4px">
                        Etkinliğin detayını görebilen herkes gündemi de görür.
                    </div>
                </div>

                <div>
                    <label class="etiket" for="olay-ozel-not">Özel notlar</label>
                    <textarea id="olay-ozel-not" class="alan" rows="3"
                              placeholder="Yalnızca sizin göreceğiniz hazırlık notları"
                              @bind="Draft.PrivateNotes" @bind:event="oninput"></textarea>
                    <div style="font-size:11px;color:var(--metin-3);margin-top:4px">
                        🔒 Davetliler bunu görmez; yalnızca etkinliği düzenleyebilenler görür.
                        Dışa aktarmaya ve CalDAV eşitlemesine de dahil edilmez.
                    </div>
                </div>
            </div>
        </details>

    </div>

    @if (_namingTemplate)
    {
        <div class="panel__alt" style="gap:6px">
            <input class="alan" style="flex:1" placeholder="Şablonun adı"
                   aria-label="Şablonun adı" @bind="_templateName" @bind:event="oninput"
                   @onkeydown="TemplateNameKey" />

            <button class="dugme" @onclick="() => _namingTemplate = false">Vazgeç</button>
            <button class="dugme dugme--birincil"
                    disabled="@string.IsNullOrWhiteSpace(_templateName)"
                    @onclick="SaveTemplate">Şablonu kaydet</button>
        </div>
    }

    <div class="panel__alt">
        @if (!Draft.IsNew)
        {
            <button class="dugme dugme--tehlike" @onclick="() => OnDelete.InvokeAsync()">Sil</button>
        }

        <button class="dugme dugme--sade" title="Bu etkinliğin içeriğini şablon olarak sakla"
                @onclick="BeginNamingTemplate">☆ Şablon</button>

        <span class="panel__bosluk"></span>
        <button class="dugme" @onclick="() => OnCancel.InvokeAsync()">Vazgeç</button>
        <button class="dugme dugme--birincil" @onclick="Save">Kaydet</button>
    </div>
</div>

@code {
    [CascadingParameter] public required CalendarUiState State { get; set; }

    [Parameter, EditorRequired] public required EventDraft Draft { get; set; }

    [Parameter] public EventCallback<EventDraft> OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Zamanlama yardımcısını açar; seçilen aralık taslağa geri yazılır.</summary>
    [Parameter] public EventCallback<EventDraft> OnFindTime { get; set; }

    /// <summary>Bir katılımcının zaman önerisi kabul edildiğinde.</summary>
    [Parameter] public EventCallback<AttendeeDraft> OnAcceptProposal { get; set; }

    /// <summary>Organizatör tüm yanıtları sıfırlayıp yeniden sormak istediğinde.</summary>
    [Parameter] public EventCallback OnResetResponses { get; set; }

    [Inject] public required IServiceScopeFactory Scopes { get; set; }

    private List<string> _problems = [];

    private bool _previewDescription;

    private List<SavedLocation> _savedLocations = [];
    private List<EventTemplate> _templates = [];

    private bool _namingTemplate;
    private string _templateName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await using var scope = Scopes.CreateAsyncScope();

        _savedLocations = await scope.ServiceProvider
            .GetRequiredService<LocationService>().SuggestAsync(State.ActiveUserId);

        _templates = await scope.ServiceProvider
            .GetRequiredService<TemplateService>().GetAsync(State.ActiveUserId);
    }

    private async Task ApplyTemplate(Guid templateId)
    {
        await using var scope = Scopes.CreateAsyncScope();

        var payload = await scope.ServiceProvider
            .GetRequiredService<TemplateService>().UseAsync(templateId);

        if (payload is null) return;

        Draft.ApplyTemplate(payload, State.Users);
        _problems = [];
    }

    private async Task DeleteTemplate(Guid templateId)
    {
        await using var scope = Scopes.CreateAsyncScope();
        var templates = scope.ServiceProvider.GetRequiredService<TemplateService>();

        await templates.DeleteAsync(templateId);
        _templates = await templates.GetAsync(State.ActiveUserId);
    }

    private void BeginNamingTemplate()
    {
        _namingTemplate = true;

        // Ad önerisi başlıktan gelir; kullanıcı çoğu zaman aynısını yazacaktı.
        _templateName = string.IsNullOrWhiteSpace(_templateName)
            ? Draft.Title.Trim()
            : _templateName;
    }

    private async Task TemplateNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveTemplate();
        else if (e.Key == "Escape") _namingTemplate = false;
    }

    private async Task SaveTemplate()
    {
        if (string.IsNullOrWhiteSpace(_templateName)) return;

        await using var scope = Scopes.CreateAsyncScope();
        var templates = scope.ServiceProvider.GetRequiredService<TemplateService>();

        var saved = await templates.SaveAsync(State.ActiveUserId, _templateName, Draft.ToTemplate());

        if (saved is null)
        {
            _problems = [$"En fazla {TemplateService.MaxPerUser} şablon tutulabilir. Önce birini silin."];
            return;
        }

        _templates = await templates.GetAsync(State.ActiveUserId);
        _namingTemplate = false;

        State.ShowStatus($"\"{saved.Name}\" şablonu kaydedildi.");
    }

    /// <summary>Yapıştırılan adresten sağlayıcıyı tanır; kullanıcı elle değiştirebilir.</summary>
    private void OnMeetingUrlChanged(ChangeEventArgs e)
    {
        Draft.OnlineMeetingUrl = e.Value?.ToString();

        if (MeetingLinks.DetectProvider(Draft.OnlineMeetingUrl) is { } provider)
        {
            Draft.OnlineMeetingProvider = provider;
        }
    }

    private void CreateMeetingLink()
    {
        Draft.OnlineMeetingUrl = MeetingLinks.CreateJitsiUrl(Draft.Title);
        Draft.OnlineMeetingProvider = "jitsi";
    }

    /// <summary>Bir biçimlendirme düğmesi: seçili metni sarar ya da satır başına ek koyar.</summary>
    private sealed record FormatTool(string Label, string Title, string Marker, bool IsLinePrefix = false);

    private static readonly FormatTool[] Tools =
    [
        new("<b>K</b>", "Kalın (**metin**)", "**"),
        new("<i>E</i>", "Eğik (*metin*)", "*"),
        new("<s>Ç</s>", "Üstü çizili (~~metin~~)", "~~"),
        new("•", "Madde listesi", "- ", IsLinePrefix: true),
        new("1.", "Numaralı liste", "1. ", IsLinePrefix: true),
        new("H", "Başlık", "## ", IsLinePrefix: true),
    ];

    private bool HasAgendaOrNotes
        => !string.IsNullOrWhiteSpace(Draft.AgendaText) || !string.IsNullOrWhiteSpace(Draft.PrivateNotes);

    /// <summary>
    /// Biçim işaretini metnin sonuna ekler. İmleç konumunu okumak için JS gerekirdi;
    /// bunun yerine örnek bir kalıp eklenir, kullanıcı içine yazar.
    /// </summary>
    private void ApplyFormat(FormatTool tool)
    {
        _previewDescription = false;

        var current = Draft.DescriptionHtml ?? string.Empty;

        if (tool.IsLinePrefix)
        {
            // Satır ortasındaysak yeni satıra geçilir; liste imi satır başında olmalı.
            if (current.Length > 0 && !current.EndsWith('\n')) current += '\n';
            Draft.DescriptionHtml = current + tool.Marker;
            return;
        }

        Draft.DescriptionHtml = current + tool.Marker + "metin" + tool.Marker;
    }

    private static readonly string[] Palette =
        ["tomato", "flamingo", "tangerine", "banana", "sage", "basil",
         "peacock", "blueberry", "lavender", "grape", "graphite"];

    private static readonly int[] ReminderChoices =
        [0, 5, 10, 15, 30, 60, 120, 24 * 60, 2 * 24 * 60, 7 * 24 * 60];

    /// <summary>Zaman dilimi listesi kısa tutulur; tam liste yüzlerce satırdır.</summary>
    private static readonly string[] CommonZones =
    [
        "Europe/Istanbul", "Europe/London", "Europe/Berlin", "Europe/Paris", "Europe/Moscow",
        "America/New_York", "America/Chicago", "America/Los_Angeles", "America/Sao_Paulo",
        "Asia/Dubai", "Asia/Tokyo", "Asia/Shanghai", "Asia/Kolkata", "Australia/Sydney", "UTC",
    ];

    private bool HasPrivateCategory
        => State.Categories.Any(c => c.IsPrivate && Draft.CategoryIds.Contains(c.Id));

    private void ToggleAllDay(ChangeEventArgs e)
    {
        Draft.IsAllDay = (bool)(e.Value ?? false);
        Draft.OnAllDayChanged();
    }

    /// <summary>Başlangıç günü değişince bitiş aynı süreyi koruyarak kayar.</summary>
    private void OnStartDateChanged(ChangeEventArgs e)
    {
        var previous = Draft.Start;
        Draft.StartDate = e.Value?.ToString() ?? Draft.StartDate;
        Draft.ShiftEndWithStart(previous);
    }

    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        var previous = Draft.Start;
        Draft.StartTime = e.Value?.ToString() ?? Draft.StartTime;
        Draft.ShiftEndWithStart(previous);
    }

    private void ToggleCategory(Guid id)
    {
        if (!Draft.CategoryIds.Remove(id)) Draft.CategoryIds.Add(id);
    }

    private void AddReminder()
    {
        // Zaten var olan bir süreyi ikinci kez eklemek anlamsız; ilk boş seçenek alınır.
        var used = Draft.Reminders.Select(r => r.MinutesBefore).ToHashSet();
        var next = ReminderChoices.FirstOrDefault(m => !used.Contains(m), 30);

        Draft.Reminders.Add(new ReminderInput(next));
    }

    private void SetReminderMinutes(int index, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var minutes)) return;

        Draft.Reminders[index] = Draft.Reminders[index] with { MinutesBefore = minutes };
    }

    private async Task Save()
    {
        _problems = [.. Draft.Validate()];
        if (_problems.Count > 0) return;

        await OnSave.InvokeAsync(Draft);
    }
}
