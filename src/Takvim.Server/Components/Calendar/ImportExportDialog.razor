@* ICS içe ve dışa aktarma. *@

<div class="perde" @onclick="() => OnClose.InvokeAsync()"></div>

<div class="panel" role="dialog" aria-modal="true" aria-label="İçe ve dışa aktarma">

    <div class="panel__ust">
        <h2 class="panel__baslik">İçe / dışa aktar</h2>
        <button class="dugme dugme--simge" aria-label="Kapat" @onclick="() => OnClose.InvokeAsync()">✕</button>
    </div>

    <div class="panel__govde">

        <section>
            <h3 style="font-size:14px;margin:0 0 8px">Dışa aktar</h3>
            <p style="color:var(--metin-2);margin:0 0 10px">
                Seçilen takvim iCalendar (.ics) dosyası olarak indirilir. Diğer takvim
                uygulamaları bu dosyayı doğrudan okuyabilir.
            </p>

            <div style="display:flex;gap:8px;align-items:end">
                <div style="flex:1">
                    <label class="etiket" for="disa-takvim">Takvim</label>
                    <select id="disa-takvim" class="alan" @bind="_exportCalendarId">
                        <option value="@Guid.Empty">Kendi takvimlerimin tümü</option>
                        @foreach (var calendar in State.Calendars.Where(c => c.OwnerUserId == State.ActiveUserId))
                        {
                            <option value="@calendar.Id">@calendar.Name</option>
                        }
                    </select>
                </div>
                <button class="dugme dugme--birincil" disabled="@_working" @onclick="Export">İndir</button>
            </div>
        </section>

        <hr style="border:none;border-top:1px solid var(--cizgi)" />

        <section>
            <h3 style="font-size:14px;margin:0 0 8px">İçe aktar</h3>
            <p style="color:var(--metin-2);margin:0 0 10px">
                Bir .ics dosyası seçin. Etkinlikler seçtiğiniz takvime eklenir;
                var olanların üzerine yazılmaz.
            </p>

            <div>
                <label class="etiket" for="ice-takvim">Hedef takvim</label>
                <select id="ice-takvim" class="alan" @bind="_importCalendarId">
                    @foreach (var calendar in State.WritableCalendars)
                    {
                        <option value="@calendar.Id">@calendar.Name</option>
                    }
                </select>
            </div>

            <div style="margin-top:10px">
                <InputFile class="alan" style="padding:6px" accept=".ics,text/calendar"
                           OnChange="OnFileSelected" disabled="@_working" />
            </div>

            @if (_result is { } result)
            {
                <div style="margin-top:12px;padding:10px;border-radius:var(--yuvarlak);background:var(--zemin-2)">
                    <div style="font-weight:500">
                        @result.EventCount etkinlik okundu@(result.ExceptionCount > 0 ? $", {result.ExceptionCount} istisna" : "").
                    </div>

                    @if (result.Warnings.Count > 0)
                    {
                        <details style="margin-top:6px">
                            <summary style="cursor:pointer;color:var(--uyari)">
                                @result.Warnings.Count uyarı
                            </summary>
                            <ul style="margin:6px 0 0;padding-left:18px;font-size:12px;color:var(--metin-2)">
                                @foreach (var warning in result.Warnings.Take(20))
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </details>
                    }

                    @if (!_imported)
                    {
                        <button class="dugme dugme--birincil" style="margin-top:10px"
                                disabled="@(_working || result.Events.Count == 0)"
                                @onclick="ConfirmImport">
                            @result.Events.Count kaydı ekle
                        </button>
                    }
                </div>
            }
        </section>

    </div>

    <div class="panel__alt">
        <span class="panel__bosluk"></span>
        <button class="dugme" @onclick="() => OnClose.InvokeAsync()">Kapat</button>
    </div>
</div>

@code {
    [CascadingParameter] public required CalendarUiState State { get; set; }

    [Inject] public required IServiceScopeFactory Scopes { get; set; }
    [Inject] public required Takvim.Core.Ics.IcsSerializer Ics { get; set; }
    [Inject] public required IJSRuntime Js { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>İçe aktarılabilecek en büyük dosya. Daha büyüğü bellekte tutulmaz.</summary>
    private const long MaxFileBytes = 12 * 1024 * 1024;

    private Guid _exportCalendarId = Guid.Empty;
    private Guid _importCalendarId;
    private Takvim.Core.Ics.IcsImportResult? _result;
    private bool _working;
    private bool _imported;

    protected override void OnInitialized()
        => _importCalendarId = State.DefaultCalendar?.Id ?? Guid.Empty;

    private async Task Export()
    {
        _working = true;
        try
        {
            List<Event> events;
            string calendarName;

            await using (var scope = Scopes.CreateAsyncScope())
            {
                var db = scope.ServiceProvider.GetRequiredService<Takvim.Data.TakvimDbContext>();

                // Dışa aktarma yalnızca kullanıcının kendi takvimlerini kapsar.
                // Paylaşılmış bir takvimi görebilmek, onu dosyaya dökme hakkı vermez.
                var owned = State.Calendars
                    .Where(c => c.OwnerUserId == State.ActiveUserId)
                    .Select(c => c.Id)
                    .ToList();

                if (_exportCalendarId != Guid.Empty)
                {
                    owned = owned.Where(id => id == _exportCalendarId).ToList();
                }

                events = await db.Events
                    .AsNoTracking()
                    .Include(e => e.Reminders)
                    .Where(e => e.DeletedAt == null && owned.Contains(e.CalendarId))
                    .ToListAsync();
            }

            calendarName = _exportCalendarId == Guid.Empty
                ? "Takvimlerim"
                : State.CalendarOf(_exportCalendarId)?.Name ?? "Takvim";

            var ics = Ics.Export(events, calendarName);
            var fileName = Takvim.Core.Ics.IcsSerializer.SuggestFileName(calendarName);

            await Js.InvokeVoidAsync("takvim.downloadText", fileName, ics, "text/calendar;charset=utf-8");
            State.ShowStatus($"{events.Count} etkinlik dışa aktarıldı.");
        }
        finally
        {
            _working = false;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _imported = false;
        _result = null;
        _working = true;

        try
        {
            var file = e.File;
            if (file.Size > MaxFileBytes)
            {
                State.ShowStatus("Dosya çok büyük (en fazla 12 MB).");
                return;
            }

            using var reader = new StreamReader(file.OpenReadStream(MaxFileBytes));
            var text = await reader.ReadToEndAsync();

            _result = Ics.Import(text, _importCalendarId, State.ZoneId);
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ConfirmImport()
    {
        if (_result is not { } result || result.Events.Count == 0) return;

        _working = true;
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<Takvim.Data.TakvimDbContext>();

            // Aynı UID zaten varsa yeniden eklenmez; içe aktarma iki kez çalıştırılırsa
            // kayıtlar çoğalmasın.
            // Hedef takvim kullanıcının yazabildiği bir takvim olmalı.
            if (!State.WritableCalendars.Any(c => c.Id == _importCalendarId))
            {
                State.ShowStatus("Bu takvime yazma yetkiniz yok.");
                return;
            }

            var existingUids = await db.Events
                .Where(e => e.CalendarId == _importCalendarId)
                .Select(e => e.Uid)
                .ToListAsync();

            var known = existingUids.ToHashSet(StringComparer.Ordinal);
            var toAdd = result.Events.Where(e => !known.Contains(e.Uid)).ToList();

            foreach (var ev in toAdd)
            {
                ev.CalendarId = _importCalendarId;
                db.Events.Add(ev);
            }

            await db.SaveChangesAsync();

            _imported = true;
            State.ShowStatus(toAdd.Count == result.Events.Count
                ? $"{toAdd.Count} etkinlik içe aktarıldı."
                : $"{toAdd.Count} etkinlik içe aktarıldı, {result.Events.Count - toAdd.Count} tanesi zaten vardı.");
        }
        finally
        {
            _working = false;
        }

        await OnChanged.InvokeAsync();
    }
}
